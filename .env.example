# Postgres connection string.
# On Vercel this is injected automatically when you create the database from
# Storage -> Create Database -> Neon. For local development, run
# `vercel env pull .env` to copy it down, or point it at any local Postgres.
DATABASE_URL=postgresql://user:password@localhost:5432/ma2026

# Signs the session cookie. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=replace-me-with-a-32-character-or-longer-random-string

# Optional. When set, `npm run db:seed` (and POST /api/seed) creates the first
# administrator account. Remove them once the admin exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Optional. Enables POST /api/seed for loading the curriculum into an empty
# database from the browser. Leave unset to keep the endpoint disabled.
SEED_SECRET=
